{
  "name": "metigan",
  "version": "2.4.0",
  "description": "Official Metigan SDK — send emails (bulk, OTP, transactional), manage forms, contacts and audiences. Zero runtime dependencies, TypeScript-first, works in Node.js and the browser.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/metigan.global.js",
  "jsdelivr": "./dist/metigan.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "email",
    "email-api",
    "transactional-email",
    "otp",
    "forms",
    "contacts",
    "audiences",
    "marketing",
    "marketing-automation",
    "newsletter",
    "subscribers",
    "api",
    "metigan",
    "typescript",
    "sdk",
    "zero-dependencies"
  ],
  "author": "Metigan <support@metigan.io>",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frantchessico/metigan-lib.git"
  },
  "bugs": {
    "url": "https://github.com/frantchessico/metigan-lib/issues"
  },
  "homepage": "https://metigan.io"
}
